<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tn.fss.lsi3</groupId>
    <artifactId>CalculatriceWS</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>TP2 - CalculatriceWS (Jakarta XML Web Services)</name>
    <description>Service web SOAP Calculatrice publié avec Endpoint.publish</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Depuis Java 9 (et retiré en Java 11), JAX-WS n'est plus inclus dans le JDK :
        il faut ajouter les dépendances Jakarta XML Web Services via Maven.
    -->
    <dependencies>
        <!-- API Jakarta XML Web Services : interfaces comme Endpoint -->
        <dependency>
            <groupId>jakarta.xml.ws</groupId>
            <artifactId>jakarta.xml.ws-api</artifactId>
            <version>4.0.0</version>
        </dependency>
        <!-- Implémentation de référence (RI) : exécute le service, génère le WSDL -->
        <dependency>
            <groupId>com.sun.xml.ws</groupId>
            <artifactId>jaxws-rt</artifactId>
            <version>4.0.2</version>
        </dependency>
        <!-- API Jakarta JWS : annotations @WebService, @WebMethod, @WebParam -->
        <dependency>
            <groupId>jakarta.jws</groupId>
            <artifactId>jakarta.jws-api</artifactId>
            <version>3.0.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Lancer le serveur avec : mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>serveur.ServeurJWS</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
