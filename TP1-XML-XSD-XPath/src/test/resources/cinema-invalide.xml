            <note>11.5</note>
            <acteurs>
                <acteur>Acteur</acteur>
            </acteurs>
        </film>
        <film id="F01" genre="Drame">
            <titre>Identifiant mal formé</titre>
            <realisateur>Inconnu</realisateur>
