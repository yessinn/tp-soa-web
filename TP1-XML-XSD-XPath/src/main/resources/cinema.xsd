<?xml version="1.0" encoding="UTF-8"?>
<!--
    Schéma XSD du document cinema.xml
    Domaine : gestion d'un cinéma (films, salles, séances, utilisateurs, réservations)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- ===================== Types simples (restrictions) ===================== -->

    <!-- Identifiants : préfixe + chiffres (ex. F001, S1, SE01, U01, R001) -->
    <xs:simpleType name="IdFilmType">
        <xs:restriction base="xs:string">
            <xs:pattern value="F[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IdSalleType">
        <xs:restriction base="xs:string">
            <xs:pattern value="S[0-9]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IdSeanceType">
        <xs:restriction base="xs:string">
            <xs:pattern value="SE[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IdUtilisateurType">
        <xs:restriction base="xs:string">
            <xs:pattern value="U[0-9]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="IdReservationType">
        <xs:restriction base="xs:string">
            <xs:pattern value="R[0-9]{3}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Genre de film : liste fermée de valeurs -->
    <xs:simpleType name="GenreType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Action"/>
            <xs:enumeration value="Animation"/>
            <xs:enumeration value="Comedie"/>
            <xs:enumeration value="Drame"/>
            <xs:enumeration value="Science-Fiction"/>
            <xs:enumeration value="Thriller"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="LangueType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="VO"/>
            <xs:enumeration value="VF"/>
            <xs:enumeration value="VOSTFR"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Note sur 10 avec une décimale -->
    <xs:simpleType name="NoteType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="10"/>
            <xs:fractionDigits value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Durée en minutes -->
    <xs:simpleType name="DureeType">
        <xs:restriction base="xs:positiveInteger">
            <xs:maxInclusive value="300"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AnneeType">
        <xs:restriction base="xs:gYear">
            <xs:minInclusive value="1895"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Prix en dinars tunisiens (3 chiffres après la virgule) -->
    <xs:simpleType name="PrixType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
            <xs:fractionDigits value="3"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TypeSalleType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Standard"/>
            <xs:enumeration value="3D"/>
            <xs:enumeration value="IMAX"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="AbonnementType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Aucun"/>
            <xs:enumeration value="Standard"/>
            <xs:enumeration value="Premium"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="EmailType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[^@\s]+@[^@\s]+\.[a-zA-Z]{2,}"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ===================== Types complexes ===================== -->

    <xs:complexType name="ActeursType">
        <xs:sequence>
            <xs:element name="acteur" type="xs:string" minOccurs="1" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="FilmType">
        <xs:sequence>
            <xs:element name="titre" type="xs:string"/>
            <xs:element name="realisateur" type="xs:string"/>
            <xs:element name="annee" type="AnneeType"/>
            <xs:element name="duree" type="DureeType"/>
            <xs:element name="note" type="NoteType"/>
            <xs:element name="acteurs" type="ActeursType"/>
            <xs:element name="synopsis" type="xs:string" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="IdFilmType" use="required"/>
        <xs:attribute name="genre" type="GenreType" use="required"/>
        <xs:attribute name="langue" type="LangueType" default="VF"/>
    </xs:complexType>

    <xs:complexType name="SalleType">
        <xs:attribute name="id" type="IdSalleType" use="required"/>
        <xs:attribute name="nom" type="xs:string" use="required"/>
        <xs:attribute name="capacite" type="xs:positiveInteger" use="required"/>
        <xs:attribute name="type" type="TypeSalleType" use="required"/>
    </xs:complexType>

    <xs:complexType name="SeanceType">
        <xs:sequence>
            <xs:element name="date" type="xs:date"/>
            <xs:element name="heure" type="xs:time"/>
            <xs:element name="prix" type="PrixType"/>
        </xs:sequence>
        <xs:attribute name="id" type="IdSeanceType" use="required"/>
        <xs:attribute name="film" type="IdFilmType" use="required"/>
        <xs:attribute name="salle" type="IdSalleType" use="required"/>
        <xs:attribute name="promotion" type="xs:boolean" default="false"/>
    </xs:complexType>

    <xs:complexType name="UtilisateurType">
        <xs:sequence>
            <xs:element name="nom" type="xs:string"/>
            <xs:element name="prenom" type="xs:string"/>
            <xs:element name="email" type="EmailType"/>
            <xs:element name="abonnement" type="AbonnementType"/>
        </xs:sequence>
        <xs:attribute name="id" type="IdUtilisateurType" use="required"/>
        <xs:attribute name="actif" type="xs:boolean" use="required"/>
    </xs:complexType>

    <xs:complexType name="ReservationType">
        <xs:attribute name="id" type="IdReservationType" use="required"/>
        <xs:attribute name="utilisateur" type="IdUtilisateurType" use="required"/>
        <xs:attribute name="seance" type="IdSeanceType" use="required"/>
        <xs:attribute name="places">
            <xs:simpleType>
                <xs:restriction base="xs:positiveInteger">
                    <xs:maxInclusive value="10"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>

    <!-- ===================== Élément racine ===================== -->

    <xs:element name="cinema">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="films">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="film" type="FilmType" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="salles">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="salle" type="SalleType" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="seances">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="seance" type="SeanceType" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="utilisateurs">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="utilisateur" type="UtilisateurType" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
                <xs:element name="reservations">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="reservation" type="ReservationType" minOccurs="0" maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
            <xs:attribute name="nom" type="xs:string" use="required"/>
            <xs:attribute name="ville" type="xs:string" use="required"/>
        </xs:complexType>

        <!-- ============ Contraintes d'intégrité (clés / références) ============ -->

        <!-- Unicité des identifiants -->
        <xs:key name="cleFilm">
            <xs:selector xpath="films/film"/>
            <xs:field xpath="@id"/>
        </xs:key>
        <xs:key name="cleSalle">
            <xs:selector xpath="salles/salle"/>
            <xs:field xpath="@id"/>
        </xs:key>
        <xs:key name="cleSeance">
            <xs:selector xpath="seances/seance"/>
            <xs:field xpath="@id"/>
        </xs:key>
        <xs:key name="cleUtilisateur">
            <xs:selector xpath="utilisateurs/utilisateur"/>
            <xs:field xpath="@id"/>
        </xs:key>
        <xs:key name="cleReservation">
            <xs:selector xpath="reservations/reservation"/>
            <xs:field xpath="@id"/>
        </xs:key>
        <xs:unique name="emailUnique">
            <xs:selector xpath="utilisateurs/utilisateur"/>
            <xs:field xpath="email"/>
        </xs:unique>

        <!-- Références (équivalent des clés étrangères) -->
        <xs:keyref name="refSeanceFilm" refer="cleFilm">
            <xs:selector xpath="seances/seance"/>
            <xs:field xpath="@film"/>
        </xs:keyref>
        <xs:keyref name="refSeanceSalle" refer="cleSalle">
            <xs:selector xpath="seances/seance"/>
            <xs:field xpath="@salle"/>
        </xs:keyref>
        <xs:keyref name="refReservationUtilisateur" refer="cleUtilisateur">
            <xs:selector xpath="reservations/reservation"/>
            <xs:field xpath="@utilisateur"/>
        </xs:keyref>
        <xs:keyref name="refReservationSeance" refer="cleSeance">
            <xs:selector xpath="reservations/reservation"/>
            <xs:field xpath="@seance"/>
        </xs:keyref>
    </xs:element>

</xs:schema>
